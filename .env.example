#Image versions are pinned in docker-compose.yml, uncomment only to override them on this machine
#NGINX_PROXY_VERSION=1.7
#ACME_COMPANION_VERSION=latest
#SELF_SIGNED_VERSION=latest
#MAILPIT_VERSION=v1.31.6
#OPENSEARCH_VERSION=3.9.0
#PHPMYADMIN_VERSION=latest
#RABBITMQ_VERSION=4.1

#compose profile, leave empty to run only nginx-proxy
#possible values: acme, self-signed
COMPOSE_PROFILES=self-signed

#output of ~id -u and ~id -g commands
USER_ID=1000
GROUP_ID=1000

#Domains
#Mail UI (Mailpit)
MAILCATCHER=mail.test
PHPMYADMIN=db.test
RABBITMQ=rabbitmq.test

#Docker log rotation for all containers of this stack
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

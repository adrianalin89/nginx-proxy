#!/usr/bin/env bash
# Report (default) or remove (--force) Docker leftovers that take space:
#   - networks no container uses, running or stopped (the shared networks created
#     by bin/setup are always kept)
#   - dangling images (untagged layers left by rebuilds)
#   - build cache
# Volumes are only listed, never removed: an unused volume can be the database
# of a project whose containers were removed (docker volume rm <name> by hand).
#
# Usage:
#   bin/cleanup                 show what would be removed
#   bin/cleanup --force         remove, asking y/n for every network, every dangling
#                               image and the build cache
#   bin/cleanup --force --yes   remove everything listed without asking

cd "$(dirname "$0")/.." || exit 1

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

FORCE=0
ASSUME_YES=0
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=1 ;;
    --yes|-y) ASSUME_YES=1 ;;
  esac
done

# confirm "question" -> 0 on y/Y, always yes with --yes
confirm() {
  [ "$ASSUME_YES" -eq 1 ] && return 0
  local reply
  read -r -p "$1 [y/N] " reply < /dev/tty
  [[ "$reply" =~ ^[Yy]$ ]]
}

# Networks that must always exist (bin/setup) plus Docker's own
KEEP_NETWORKS="nginx-proxy shared-db-network mail-catcher-network open-search-network rabbitmq-network bridge host none"

echo -e "${BLUE}Unused networks${NC}"
UNUSED_NETWORKS=()
for network in $(docker network ls --format '{{.Name}}'); do
  [[ " $KEEP_NETWORKS " == *" $network "* ]] && continue
  # -a: stopped containers still need their networks to start again
  if [ -z "$(docker ps -aq --filter "network=$network")" ]; then
    UNUSED_NETWORKS+=("$network")
    echo "  $network"
  fi
done
[ ${#UNUSED_NETWORKS[@]} -eq 0 ] && echo "  none"

echo ""
echo -e "${BLUE}Dangling images${NC}"
DANGLING=$(docker images -f dangling=true -q | sort -u)
if [ -n "$DANGLING" ]; then
  echo "  $(echo "$DANGLING" | wc -l) image(s)"
else
  echo "  none"
fi

echo ""
echo -e "${BLUE}Disk usage (docker system df)${NC}"
docker system df | sed 's/^/  /'

echo ""
echo -e "${BLUE}Build cache${NC}"
docker system df --format '{{.Type}}\t{{.Size}}\t{{.Reclaimable}}' | grep -i 'build cache' | awk -F'\t' '{print "  size " $2 ", reclaimable " $3}'

echo ""
echo -e "${BLUE}Volumes not used by any container (listed only, never removed)${NC}"
VOLUMES=$(docker volume ls -f dangling=true --format '{{.Name}}')
if [ -n "$VOLUMES" ]; then
  echo "$VOLUMES" | sed 's/^/  /'
  echo -e "  ${YELLOW}Check before removing: docker volume rm <name>${NC}"
else
  echo "  none"
fi

echo ""
if [ "$FORCE" -ne 1 ]; then
  echo -e "${YELLOW}Nothing removed. Run bin/cleanup --force to remove them (asks y/n for each).${NC}"
  exit 0
fi

REMOVED=0

for network in "${UNUSED_NETWORKS[@]}"; do
  if confirm "Remove network $network?"; then
    docker network rm "$network" >/dev/null && echo -e "  ${GREEN}removed${NC}" && REMOVED=$((REMOVED + 1))
  fi
done

for image in $DANGLING; do
  info=$(docker image inspect "$image" --format '{{.Created}} {{.Size}}' 2>/dev/null) || continue
  created=$(echo "$info" | cut -c1-10)
  size=$(( $(echo "$info" | awk '{print $2}') / 1000000 ))
  if confirm "Remove dangling image ${image:0:12} (created $created, ${size}MB)?"; then
    # Fails without --force when a stopped container still uses it, that's fine
    docker image rm "$image" >/dev/null && echo -e "  ${GREEN}removed${NC}" && REMOVED=$((REMOVED + 1))
  fi
done

BUILD_CACHE=$(docker system df --format '{{.Type}}\t{{.Reclaimable}}' | grep -i 'build cache' | cut -f2)
if confirm "Remove the build cache (reclaimable ${BUILD_CACHE:-unknown})?"; then
  docker builder prune -f >/dev/null && echo -e "  ${GREEN}removed${NC}" && REMOVED=$((REMOVED + 1))
fi

echo -e "${GREEN}Done, $REMOVED item(s) removed.${NC}"

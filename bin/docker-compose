#!/usr/bin/env bash

if docker compose version > /dev/null 2>&1; then
  DOCKER_COMPOSE="docker compose"
else
  DOCKER_COMPOSE="docker-compose"
fi

COMPOSE_FILES=(-f docker-compose.yml)
# Machine-specific additions (ex. proxy network aliases), not committed.
[ -f compose.override.yaml ] && COMPOSE_FILES+=(-f compose.override.yaml)

${DOCKER_COMPOSE} "${COMPOSE_FILES[@]}" "$@"

#!/usr/bin/env bash

# Copy .env.example to .env if .env does not exist
[ ! -f .env ] && cp .env.example .env

# Get user and group ID
USER_ID=$(id -u)
GROUP_ID=$(id -g)

# Replace USER_ID and GROUP_ID in .env
sed -i "s/^USER_ID=.*/USER_ID=${USER_ID}/" .env
sed -i "s/^GROUP_ID=.*/GROUP_ID=${GROUP_ID}/" .env
echo "Replacing USER_ID and GROUP_ID in .env"
source .env
# Shared Docker networks used by the projects (external in their compose files)
for NETWORK_NAME in nginx-proxy shared-db-network mail-catcher-network open-search-network rabbitmq-network; do
  # Exact name match (a "grep" on "docker network ls" also matched similar names)
  if ! docker network inspect "$NETWORK_NAME" >/dev/null 2>&1; then
    echo "Creating Docker network: ${NETWORK_NAME}"
    docker network create "${NETWORK_NAME}"
  fi
done

# Local domains of the shared tools in /etc/hosts
for DOMAIN in "${RABBITMQ}" "${MAILCATCHER}" "${PHPMYADMIN}"; do
  [ -z "$DOMAIN" ] && continue
  # Whole host name match, "db.test" must not match "mydb.test"
  if ! grep -qE "[[:space:]]${DOMAIN//./\\.}([[:space:]]|$)" /etc/hosts; then
    echo "Your system password is needed to add ${DOMAIN} to /etc/hosts..."
    echo "127.0.0.1 ::1 ${DOMAIN}" | sudo tee -a /etc/hosts
  fi
done

# Print instructions to run the start command
echo "Run the following command to start the containers:"
echo "./bin/start"

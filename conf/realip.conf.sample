# Real client IP when a WAF / load balancer sits in front of this server.
# Copy to conf/realip.conf (not committed) on that server, set its address, then
#   docker exec proxy-nginx-proxy nginx -s reload
# Every request from the address below is trusted to carry the client IP in X-Forwarded-For;
# recursive skips further trusted hops (ex. a corporate proxy in front of the WAF). Clients that
# reach the server directly keep their own address. The proxy passes the result on to the sites in
# X-Real-IP / X-Forwarded-For (see README, "Behind a WAF or load balancer").
set_real_ip_from 192.0.2.10;
real_ip_header X-Forwarded-For;
real_ip_recursive on;
